# ---------------------------------------------------------------------------
# Local runtime configuration.
#
#   cp .env.example .env      # .env is git-ignored, .env.example is not
#
# Never commit real keys. `npm test` runs scripts/check-secrets.mjs, which
# fails the build if a key-shaped value shows up in a tracked file.
# ---------------------------------------------------------------------------

# --- Option A: DeepSeek (OpenAI-compatible) --------------------------------
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# --- Option B: any OpenAI-compatible gateway ------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# --- Server ---------------------------------------------------------------
# PORT=3001
# AGENT_DATA_DIR=.data   # local task + event history

# --- Console (apps/agent-console/.env) ------------------------------------
# VITE_AGENT_SERVER_URL=http://127.0.0.1:3001
# VITE_AGENT_DEMO_PACING=true  # opt-in paced replay; default is real-time
